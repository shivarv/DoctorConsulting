# Copy to .env and fill in the password. .env is gitignored; this template is
# committed, so never put a real credential here.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Two different auth rules apply locally, and which one you hit depends on how
# you connect (see pg_hba.conf):
#
#   local  all all            trust           <- Unix socket: no password
#   host   all all 127.0.0.1  scram-sha-256   <- TCP: password required
#   host   all all ::1        scram-sha-256   <- TCP: password required
#
# A URL with @localhost is TCP, so it needs a real password. That is why
# `psql -U postgres` works with no password while the app still needs one.
#
# The app connects as `dc_app`, a role that can read and write the data but
# not alter the schema. Create it with:
#
#   psql -U postgres -d doctorconsulting -c "CREATE ROLE dc_app LOGIN PASSWORD 'yourpassword';"
#   psql -U postgres -d doctorconsulting -c "GRANT CONNECT ON DATABASE doctorconsulting TO dc_app;"
#   psql -U postgres -d doctorconsulting -c "GRANT USAGE ON SCHEMA public TO dc_app;"
#   psql -U postgres -d doctorconsulting -c "GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO dc_app;"
#   psql -U postgres -d doctorconsulting -c "GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO dc_app;"

DATABASE_URL=postgresql://dc_app:YOUR_PASSWORD@localhost:5432/doctorconsulting

# Used by psql and other libpq tools. PGPASSWORD is deliberately absent — put
# it in .env only, or use a ~/.pgpass file.
PGHOST=localhost
PGPORT=5432
PGDATABASE=doctorconsulting
PGUSER=dc_app

# ---------------------------------------------------------------------------
# Backend (optional — this is the default already in use)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173
